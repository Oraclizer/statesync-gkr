{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssgkr:memory-probe:raw:v1",
  "title": "SS-GKR memory prototype raw JSONL record",
  "type": "object",
  "required": ["schema_version", "record_type"],
  "properties": {
    "schema_version": { "const": "ssgkr.memory-probe.raw.v1" },
    "record_type": { "enum": ["fixture", "sample", "terminal", "controls", "allocator_controls"] }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "sample" } } },
      "then": {
        "required": ["mode", "family", "width_bits", "depth", "seed", "process_repeat", "sample_index", "observer_enabled", "warmup", "started_unix_ns", "prove_elapsed_ns", "verify_elapsed_ns", "protocol_verify_elapsed_ns", "input_claim_discharge_elapsed_ns", "allocator_start", "allocator_end", "allocator_peak_delta_requested_bytes", "allocator_live_delta_requested_bytes", "events", "event_count", "event_capacity", "accepted", "canonical_proof_sha256", "canonical_proof"],
        "properties": {
          "mode": { "enum": ["dense", "sparse"] },
          "family": { "enum": ["mixed", "add", "mul", "cubic_affine"] },
          "width_bits": { "type": "integer", "minimum": 1, "maximum": 16 },
          "depth": { "type": "integer", "minimum": 1, "maximum": 16 },
          "warmup": { "type": "boolean" },
          "observer_enabled": { "type": "boolean" },
          "prove_elapsed_ns": { "type": "integer", "minimum": 0 },
          "verify_elapsed_ns": { "type": "integer", "minimum": 0 },
          "protocol_verify_elapsed_ns": { "type": "integer", "minimum": 0 },
          "input_claim_discharge_elapsed_ns": { "type": "integer", "minimum": 0 },
          "allocator_start": { "$ref": "#/$defs/allocator" },
          "allocator_end": { "$ref": "#/$defs/allocator" },
          "accepted": { "const": true },
          "canonical_proof_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "fixture" } } },
      "then": {
        "required": ["mode", "family", "width_bits", "depth", "seed", "process_repeat", "samples", "warmups", "observer_enabled", "circuit_sha256", "circuit_layout_bytes_hex", "inputs", "shape", "source_sha", "probe_sha", "conceptual_layer_order", "ir_storage_layer_order", "common_gate_rule", "common_input_rule", "instrumentation", "allocator_semantics", "rss_semantics"]
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "terminal" } } },
      "then": { "required": ["status", "samples", "warmups", "process_repeat"], "properties": { "status": { "const": "PASS" } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "controls" } } },
      "then": { "required": ["family", "controls"] }
    },
    {
      "if": { "properties": { "record_type": { "const": "allocator_controls" } } },
      "then": { "required": ["allocation_growth_truncate_drop", "before", "allocated", "grown"] }
    }
  ],
  "$defs": {
    "allocator": {
      "type": "object",
      "required": ["live_requested_bytes", "peak_requested_bytes", "successful_allocation_calls", "successful_reallocation_calls", "allocated_requested_bytes", "freed_requested_bytes"],
      "properties": {
        "live_requested_bytes": { "type": "integer", "minimum": 0 },
        "peak_requested_bytes": { "type": "integer", "minimum": 0 },
        "successful_allocation_calls": { "type": "integer", "minimum": 0 },
        "successful_reallocation_calls": { "type": "integer", "minimum": 0 },
        "allocated_requested_bytes": { "type": "integer", "minimum": 0 },
        "freed_requested_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "buffer": {
      "type": "object",
      "required": ["name", "len", "capacity", "element_bytes", "len_payload_bytes", "capacity_payload_bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "len": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 0 },
        "element_bytes": { "type": "integer", "minimum": 1 },
        "len_payload_bytes": { "type": "integer", "minimum": 0 },
        "capacity_payload_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "required": ["stage", "layer_index", "round_index", "remaining_variables", "offset_ns", "elapsed_ns", "allocator", "buffers"],
      "properties": {
        "stage": { "enum": ["constructor", "round_poly", "bind"] },
        "allocator": { "$ref": "#/$defs/allocator" },
        "buffers": { "type": "array", "items": { "$ref": "#/$defs/buffer" } }
      }
    }
  }
}
